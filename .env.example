# Atlas AR — local Vite env (copy to .env.local for `npm run dev`)
# Amplify: set the same VITE_* keys under Hosting → Environment variables per branch.

# API Gateway base URL (no trailing slash). Required for production/preview builds.
VITE_ATLAS_API_URL=https://YOUR-API-ID.execute-api.ap-south-1.amazonaws.com

# Cognito User Pool (SPA, no client secret). Omit all three for local dev-auth mode.
VITE_COGNITO_REGION=ap-south-1
VITE_COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: subpath deploy (default /)
# VITE_BASE_PATH=/

# Platform operator emails (comma-separated) — grants /owner dashboard access
# VITE_PLATFORM_OWNER_EMAILS=you@company.com,ops@company.com

# --- OpenRouter agent runner (scripts/run-openrouter-agent.mjs, not baked into Vite) ---
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_KEY_DIR=d:\AI\atlas-webxr
# OPENROUTER_MODEL=qwen/qwen-2.5-coder-32b-instruct
# npm run agent:openrouter:probe

# --- Gemini agent runner (scripts/run-gemini-agent.mjs, not baked into Vite) ---
# GEMINI_API_KEY=AIza...
# GEMINI_KEY_DIR=d:\AI\atlas-webxr
# GEMINI_MODEL=gemini-2.5-flash
# npm run agent:gemini:probe
# npm run agent:gemini -- --brief agent-briefs/atlas-ar/MKT-1-landing-pricing.md

# --- Owner Cognito setup (server-side script, not baked into Vite) ---
# ATLAS_OWNER_EMAIL=director@omnimanual.com
# ATLAS_OWNER_PASSWORD=YourSecurePass123!
# npm run setup:owner
